# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── Infrastructure credentials (change in production) ────────────────────────
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=alt_password
RABBITMQ_PASSWORD=alt_password

# ── AI Providers ──────────────────────────────────────────────────────────────
# At least one provider is required. Gemini is the default.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite          # optional — override default model

# OPENAI_API_KEY=your_openai_api_key_here     # optional — enables OpenAI provider
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=your_anthropic_api_key_here  # optional — enables Claude provider
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── LLM Observability (optional) ──────────────────────────────────────────────
# Langfuse traces every generateAIText() call (script generation, the chat
# endpoint, AI insights, recorder correlation) across all 4 services that use
# it. Free tier: https://cloud.langfuse.com (no credit card). Leave both keys
# empty to disable — the LangfuseSpanProcessor is simply never registered.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # self-hosted: your own URL

# ── Security (required for production, leave empty for local dev) ───────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=
INTERNAL_API_KEY=
API_KEYS=
API_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com
# Also required for local dev once SESSION_SECRET is set: the default "*" breaks
# credentialed (cookie) browser requests, leaving the UI stuck on a blank page.
# Set this to the UI's own origin, e.g. ALLOWED_ORIGIN=http://localhost:3006
VNC_PASSWORD=

# ── Rate Limiting (optional — defaults shown) ─────────────────────────────────
# REDIS_URL=redis://redis:6379
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_MAX=20

# ── Worker Tuning (optional — defaults shown) ─────────────────────────────────
# WORKER_CONCURRENCY=1
# K6_MAX_DURATION_MS=600000
# PUPPETEER_MAX_DURATION_MS=300000
# PUPPETEER_NAV_TIMEOUT_MS=60000

# ── Data Retention (optional) ─────────────────────────────────────────────────
# STALE_RUNNING_MINUTES=15
# STALE_PENDING_MINUTES=30
# LIVE_METRICS_RETENTION_DAYS=30
# TEST_RESULTS_RETENTION_DAYS=0    # 0 = disabled; set > 0 for GDPR auto-purge

# ── Docker / Build (WSL2 + Windows filesystem workaround) ────────────────────
# If building from WSL2 with the repo on the Windows filesystem (/mnt/c/...),
# BuildKit's xattr copy fails with "input/output error". Disabling BuildKit
# uses the legacy builder which does plain file copies and avoids the issue.
# DOCKER_BUILDKIT=0

# ── Set automatically by docker-compose (do not set manually) ─────────────────
# RABBITMQ_URL=amqp://user:password@rabbitmq:5672
# DATABASE_URL=postgresql://user:password@postgres:5432/alt_db
# RESULTS_URL=http://results-service:3004
# VITE_API_URL=http://localhost:3000
# VITE_RESULTS_URL=http://localhost:3004
