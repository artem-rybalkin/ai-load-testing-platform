FROM node:22-alpine
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
WORKDIR /app
COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/tracing/package.json ./packages/tracing/
COPY services/worker-client/package.json ./services/worker-client/
COPY services/analyser-service/package.json ./services/analyser-service/
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm install --ignore-scripts && npm rebuild esbuild
WORKDIR /app/services/worker-client
CMD ["npx", "tsx", "watch", "src/index.ts"]
