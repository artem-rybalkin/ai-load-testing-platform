FROM node:22-alpine
WORKDIR /app
COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/tracing/package.json ./packages/tracing/
COPY services/api-service/package.json ./services/api-service/
COPY services/analyser-service/package.json ./services/analyser-service/
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm install
WORKDIR /app/services/api-service
CMD ["npx", "tsx", "watch", "src/index.ts"]
