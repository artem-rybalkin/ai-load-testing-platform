FROM node:20-alpine
# `novnc` pulls in the `websockify` apk package (and python3) as a transitive
# dependency — no separate python3/py3-pip/pip install needed.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont \
    xvfb x11vnc novnc
# Pre-create X11 socket directory with sticky-bit (required when running as non-root)
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV DISPLAY=:99
WORKDIR /app
COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/tracing/package.json ./packages/tracing/
COPY services/recorder-service/package.json ./services/recorder-service/
COPY services/analyser-service/package.json ./services/analyser-service/
RUN --mount=type=cache,target=/root/.npm npm install --ignore-scripts && npm rebuild esbuild
COPY services/recorder-service/docker-entrypoint-dev.sh /docker-entrypoint-dev.sh
RUN sed -i 's/\r$//' /docker-entrypoint-dev.sh && chmod +x /docker-entrypoint-dev.sh
WORKDIR /app/services/recorder-service
CMD ["/docker-entrypoint-dev.sh"]
