{
  "name": "ai-load-testing-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint services/*/src/**/*.ts packages/*/src/**/*.ts",
    "build:shared": "npm run build --workspace=packages/shared",
    "dev": "npm run build:shared && npm run dev --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "amqplib": "^1.0.3"
  }
}
