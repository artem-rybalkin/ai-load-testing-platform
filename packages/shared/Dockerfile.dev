FROM node:22-alpine
WORKDIR /app
COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/tracing/package.json ./packages/tracing/
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm install
CMD ["sh", "-c", "npx tsc -p packages/shared/tsconfig.json && npx tsc -p packages/tracing/tsconfig.json && npx tsc --watch -p packages/shared/tsconfig.json & npx tsc --watch -p packages/tracing/tsconfig.json & wait"]
